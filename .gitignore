# ==============================================================================
# GARBA NIGHT 2026 — .gitignore
# ==============================================================================

# ─── Environment / Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example          # keep the example template

# ─── Private keys / Certificates ─────────────────────────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx

# ─── Service-account / Credential JSON files ──────────────────────────────────
service-account*.json
credentials*.json
*-credentials.json
firebase*.json

# ─── Databases (never commit live data) ───────────────────────────────────────
*.db
*.sqlite3
*.sqlite

# ─── Customer uploads & payment proof screenshots ─────────────────────────────
backend/uploads/screenshots/*
!backend/uploads/screenshots/.gitkeep
backend/uploads/qr/*
!backend/uploads/qr/.gitkeep
uploads/
payment-screenshots/

# ─── Python ───────────────────────────────────────────────────────────────────
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
dist/
.dist/
*.local

# ─── IDE / OS ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
